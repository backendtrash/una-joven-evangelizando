# Plantilla de variables de entorno. Copia este archivo a `.env` y complétalo con
# valores reales. `.env` está en .gitignore y NUNCA debe subirse al repositorio.
#
# En local puedes exportar estas variables o configurarlas en tu IDE / run config.
# En Railway se inyectan como variables del servicio.

# --- Perfil activo (dev | prod) ---
SPRING_PROFILES_ACTIVE=dev

# --- Base de datos PostgreSQL (Supabase) ---
# La URL DEBE incluir sslmode=require para forzar la conexión cifrada.
# Ejemplo:
#   jdbc:postgresql://db.<proyecto>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UC1D51aQt7mQQ8avzILW51zQ

# --- Usuario administrador inicial (sembrado idempotente, ver T-08) ---
# La contraseña se guarda hasheada con BCrypt; nunca en texto plano en el código.
ADMIN_INITIAL_USERNAME=maria
ADMIN_INITIAL_PASSWORD=
